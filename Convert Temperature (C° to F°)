#include <iostream>
using namespace std;

int main()
{
    float c;
    float f;
    cout << "Please enter the degrees in celcius: \n";
    cin >> c;
    
    f = (c * 1.8) + 32;

    cout << c << " degrees celcius is equal to " << f << " degrees fahrenheit.";

    return 0;
}
